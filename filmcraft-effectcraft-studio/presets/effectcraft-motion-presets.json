{
  "version": 1,
  "description": "Production-ready EffectCraft motion presets (.ecpreset / command JSON) for high-end SaaS, commercial, and kinetic motion graphics",
  "presets": [
    {
      "id": "ec_snap_zoom_impact",
      "name": "Snap Zoom with Spatial Twitch",
      "category": "Camera & Emphasis",
      "description": "Dynamic snap punch from 100% to 138% scale using snapSettle ease, with subtle 0.8 degree rotational micro-twitch and directional motion blur.",
      "durationFrames": 14,
      "commands": [
        {
          "command": "prop.set",
          "params": {
            "path": "transform/scale",
            "time": 0.0,
            "value": [100.0, 100.0, 100.0],
            "keyframe": true
          }
        },
        {
          "command": "prop.set",
          "params": {
            "path": "transform/scale",
            "time": 0.233,
            "value": [138.0, 138.0, 100.0],
            "keyframe": true
          }
        },
        {
          "command": "prop.set",
          "params": {
            "path": "transform/rotation",
            "time": 0.0,
            "value": 0.0,
            "keyframe": true
          }
        },
        {
          "command": "prop.set",
          "params": {
            "path": "transform/rotation",
            "time": 0.066,
            "value": 0.85,
            "keyframe": true
          }
        },
        {
          "command": "prop.set",
          "params": {
            "path": "transform/rotation",
            "time": 0.233,
            "value": 0.0,
            "keyframe": true
          }
        },
        {
          "command": "keys.setTemporalEase",
          "params": {
            "path": "transform/scale",
            "keyIndex": 1,
            "outInfluence": 85.0,
            "outSpeed": 0.0,
            "inInfluence": 15.0,
            "inSpeed": 0.1
          }
        }
      ]
    },
    {
      "id": "ec_whip_pan_seam",
      "name": "Cinematic Whip Pan Transition",
      "category": "Transitions",
      "description": "High-velocity lateral camera pan using whip ease, paired with dynamic directional blur at the cut point.",
      "durationFrames": 12,
      "commands": [
        {
          "command": "prop.set",
          "params": {
            "path": "transform/position",
            "time": 0.0,
            "value": [960.0, 540.0, 0.0],
            "keyframe": true
          }
        },
        {
          "command": "prop.set",
          "params": {
