            "keyframe": true
          }
        },
        {
          "command": "prop.set",
          "params": {
            "path": "transform/position",
            "time": 0.0,
            "value": [960.0, 620.0, -350.0],
            "keyframe": true
          }
        },
        {
          "command": "prop.set",
          "params": {
            "path": "transform/xRotation",
            "time": 0.400,
            "value": 0.0,
            "keyframe": true
          }
        },
        {
          "command": "prop.set",
          "params": {
            "path": "transform/yRotation",
