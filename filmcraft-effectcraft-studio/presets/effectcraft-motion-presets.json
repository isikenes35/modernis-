    {
      "id": "ec_kinetic_text_reveal",
      "name": "Kinetic Text Range Stagger",
      "category": "Kinetic Typography",
      "description": "Per-character staggered reveal with Y-offset drop and letter-spacing expansion using Range Selector.",
      "durationFrames": 18,
      "commands": [
        {
          "command": "text.addAnimator",
          "params": { "name": "KineticReveal" }
        },
        {
          "command": "text.addSelector",
          "params": { "animator": "KineticReveal", "type": "range", "units": "percentage" }
        },
        {
          "command": "prop.set",
          "params": { "path": "text/animators/KineticReveal/properties/position", "value": [0.0, 48.0] }
        },
        {
          "command": "prop.set",
          "params": { "path": "text/animators/KineticReveal/properties/opacity", "value": 0.0 }
        },
        {
          "command": "prop.set",
          "params": { "path": "text/animators/KineticReveal/properties/tracking", "value": 25.0 }
        },
        {
          "command": "prop.set",
          "params": {
            "path": "text/animators/KineticReveal/selectors/Range/start",
            "time": 0.0,
            "value": 0.0,
            "keyframe": true
          }
        },
        {
          "command": "prop.set",
          "params": {
            "path": "text/animators/KineticReveal/selectors/Range/start",
            "time": 0.300,
            "value": 100.0,
            "keyframe": true
          }
        },
        {
          "command": "keys.setTemporalEase",
          "params": {
            "path": "text/animators/KineticReveal/selectors/Range/start",
            "keyIndex": 1,
            "outInfluence": 70.0,
            "outSpeed": 0.0,
            "inInfluence": 30.0,
            "inSpeed": 0.0
          }
        }
      ]
    },
    {
      "id": "ec_inertial_overshoot_expression",
      "name": "Inertial Bounce & Damped Decay Expression",
      "category": "Expressions",
      "description": "Physical harmonic oscillator expression applied to position, scale, or rotation to automatically create organic post-keyframe overshoot.",
      "expression": "n = 0; if (numKeys > 0) { n = nearestKey(time).index; if (key(n).time > time) n--; } if (n > 0) { t = time - key(n).time; amp = 0.05; freq = 4.0; decay = 5.0; v = velocityAtTime(key(n).time - 0.001); value + v * amp * Math.sin(freq * t * 2 * Math.PI) / Math.exp(decay * t); } else { value; }"
    }
  ]
}
