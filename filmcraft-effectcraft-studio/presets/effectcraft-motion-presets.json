            "time": 0.200,
            "value": [-960.0, 540.0, 0.0],
            "keyframe": true
          }
        },
        {
          "command": "add_effect",
          "params": {
            "effect": "ADBE Directional Blur",
            "values": {
              "Direction": 90.0,
              "Blurriness": 65.0
            }
          }
        },
        {
          "command": "keys.setTemporalEase",
          "params": {
            "path": "transform/position",
            "keyIndex": 1,
            "outInfluence": 90.0,
            "outSpeed": 0.0,
            "inInfluence": 10.0,
            "inSpeed": 0.0
          }
        }
      ]
    },
    {
      "id": "ec_3d_card_spatial_tilt",
      "name": "3D Floating Glass Card Tilt",
      "category": "3D Product Presentation",
      "description": "3D Layer rotation and Z-space entry from angle to face-on, with softRaytraced shadow and depth-of-field settle.",
      "durationFrames": 24,
      "commands": [
